PORT=5000
NODE_ENV=development
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Firebase Admin SDK: keep the service-account file outside this project.
FIREBASE_PROJECT_ID="chargerhub-ev-demo"
GOOGLE_APPLICATION_CREDENTIALS=C:/secure/firebase-service-account.json
# Alternatively, provide the service-account JSON as one environment value.
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Nearby place search. Keep this key on the server, never in client/.env.
GEOAPIFY_API_KEY=86a2d7d67f36463ea404a07e2e30ce65

# Admin API Key for external hardware/simulator endpoints
SIMULATOR_API_KEY=ev_sim_secret_token_8899


# Razorpay Test or Live credentials. Keep the secret on the server only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
